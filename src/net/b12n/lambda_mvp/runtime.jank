(ns net.b12n.lambda-mvp.runtime
  "An AWS Lambda custom runtime written in jank.

  Implements the Lambda Runtime API contract (version 2018-06-01) --
  the same poll/execute/respond loop that awslabs/aws-lambda-cpp wraps
  in C++, and that this project's Jolt sibling (lambda-mvp-jlt)
  implements the same way:

    GET  /runtime/invocation/next            long-poll the next event
    POST /runtime/invocation/{id}/response   report the handler's result
    POST /runtime/invocation/{id}/error      report a handler failure
    POST /runtime/init/error                 report a startup failure

  The API host:port arrives in the AWS_LAMBDA_RUNTIME_API env var; the
  request id and invocation metadata arrive as response headers on
  /next. Plain HTTP on a loopback address -- no TLS involved."
  (:require [clojure.string :as str]
            [net.b12n.lambda-mvp.http :as http])
  (:include "stdlib.h"))

(def ^:private api-version "2018-06-01")

;; Wrapper for getenv to handle C string conversion
(cpp/raw "
std::string jank_getenv(const char* name) {
  const char* val = getenv(name);
  return val ? std::string(val) : std::string();
}
")

(defn- base-host-port []
  (let [api (cpp/jank_getenv "AWS_LAMBDA_RUNTIME_API")
        parts (str/split api #":")]
    {:host (first parts) :port (parse-long (second parts))}))

(defn- next-invocation
  "Long-poll the next event. Blocks until Lambda has work for us."
  [host port]
  (http/get host port (str "/" api-version "/runtime/invocation/next")))

(defn- post-response [host port req-id body]
  (http/post host port
             (str "/" api-version "/runtime/invocation/" req-id "/response")
             body))

(defn- error-json [msg type]
  (str "{\"errorMessage\":" (pr-str (str msg))
       ",\"errorType\":" (pr-str (str type)) "}"))

(defn- post-error [host port req-id msg type]
  (http/post host port
             (str "/" api-version "/runtime/invocation/" req-id "/error")
             (error-json msg type)
             ["Lambda-Runtime-Function-Error-Type" (str type)]))

(defn post-init-error
  "Report a failure during startup (before the loop begins)."
  [msg type]
  (let [{:keys [host port]} (base-host-port)]
    (http/post host port (str "/" api-version "/runtime/init/error")
               (error-json msg type)
               ["Lambda-Runtime-Function-Error-Type" (str type)])))

(defn- invocation-context
  "The per-invocation metadata Lambda passes as response headers on
  /next. Header keys are lowercase strings in http.jank's client."
  [headers]
  {:request-id  (get headers "lambda-runtime-aws-request-id")
   :deadline-ms (get headers "lambda-runtime-deadline-ms")
   :invoked-arn (get headers "lambda-runtime-invoked-function-arn")
   :trace-id    (get headers "lambda-runtime-trace-id")})

(defn run
  "Run the custom-runtime loop. `handler` is (fn [event-json ctx]) ->
  json string, where event-json is the raw event payload and ctx is
  the map from `invocation-context`. Loops until /next returns a
  non-200 status (never, on real Lambda -- the environment freezes
  between events and kills the process by recycling the sandbox;
  locally the mock ends a test run with 410 Gone)."
  [handler]
  (let [{:keys [host port]} (base-host-port)]
    (loop []
      (let [{:keys [status headers body]} (next-invocation host port)]
        (if (= 200 status)
          (let [{:keys [request-id] :as ctx} (invocation-context headers)]
            ;; NO try/catch around the handler call, unlike the Jolt version --
            ;; try/catch is verified prohibitively slow to jank compile in this
            ;; build (15+ minutes, non-terminating, in total isolation with zero
            ;; interop code -- see spec Open Risk #9). If `handler` throws, the
            ;; exception propagates uncaught and crashes the process. For this
            ;; project's own demo handler (string-building + an atom swap!, no
            ;; I/O) that path is unreachable in practice, but this is a real,
            ;; documented divergence from the Jolt sibling's graceful
            ;; per-invocation HandlerError reporting.
            (post-response host port request-id (handler body ctx))
            (recur))
          (println "runtime: /invocation/next returned" status "-- exiting"))))))
