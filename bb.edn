{:tasks
 {:requires ([babashka.process :as p])

  info {:doc "task cheat-sheet"
        :task (do (println "lambda-mvp-jnk -- a shareable AWS Lambda custom runtime in jank")
                  (println "")
                  (println "  bb probe       offline e2e: mock Runtime API + real jank loop (no AWS, no Docker)")
                  (println "  bb check       headless AOT-compile of the whole src/ tree")
                  (println "  bb test        run script/bench.clj's unit tests")
                  (println "  bb demo        image + deploy + invoke in one go, prerequisites checked first")
                  (println "  bb image       docker build -> a locally tagged image (LAMBDA_ARCH, default amd64)")
                  (println "  bb deploy      idempotent: ECR repo + IAM role + Lambda function")
                  (println "  bb invoke      single ad-hoc invoke, prints response + REPORT line")
                  (println "  bb bench       cold/warm boot-time comparison across memory tiers")
                  (println "  bb teardown    delete the function + role + ECR repo")
                  (println "  bb clean       remove build artifacts")
                  (println "")
                  (println "(babashka is still required -- several tasks shell out to a real `bb`")
                  (println " binary internally.)")
                  (println "")
                  (println "No task hardcodes an AWS profile, account, or region -- see README.md"))}

  test {:doc "run script/bench.clj's unit tests"
        :task (p/shell "bb" "test/bench_test.clj")}

  check {:doc "headless AOT-compile of the whole src/ tree (the real-compile gate)"
         :task (let [{:keys [exit]} (p/shell {:continue true}
                                             "jank" "compile" "--module-path" "src"
                                             "--target-dir" "target" "--name" "bootstrap"
                                             "net.b12n.lambda-mvp.main")]
                 (System/exit exit))}

  probe {:doc "offline e2e: mock Runtime API on an OS-assigned port + the compiled binary"
         :task (let [port-file ".mock-runtime-api-port"]
                 (when (.exists (java.io.File. port-file)) (.delete (java.io.File. port-file)))
                 (let [srv (p/process ["python3" "tools/mock_runtime_api.py"] {:inherit true})]
                   (loop [n 0]
                     (when (and (not (.exists (java.io.File. port-file))) (< n 50))
                       (Thread/sleep 100)
                       (recur (inc n))))
                   (if-not (.exists (java.io.File. port-file))
                     (do (println "probe: mock server did not publish its port -- aborting")
                         (System/exit 1))
                     (let [port (.trim (slurp port-file))
                           {:keys [exit]} (p/shell {:continue true}
                                                   "jank" "compile" "--module-path" "src"
                                                   "--target-dir" "target" "--name" "bootstrap"
                                                   "net.b12n.lambda-mvp.main")]
                       (if-not (zero? exit)
                         (do (println "probe: jank compile failed") (System/exit exit))
                         (do
                           (p/shell {:extra-env {"AWS_LAMBDA_RUNTIME_API" (str "127.0.0.1:" port)}}
                                    "./target/bootstrap")
                           (System/exit (:exit (deref srv)))))))))}

  image {:doc "docker build -> a locally tagged image (LAMBDA_ARCH, default amd64 -- confirmed by Phase 0 Task 2: jank's PPA ships amd64 only for Ubuntu 24.04, arm64 does not exist)"
         :task (let [arch (or (System/getenv "LAMBDA_ARCH") "amd64")
                     platform (case arch
                                "arm64" "linux/arm64"
                                ("x86_64" "amd64") "linux/amd64"
                                (do (println "image: LAMBDA_ARCH must be arm64 or amd64, got" arch)
                                    (System/exit 1)))
                     {:keys [exit]} (p/shell {:continue true}
                                             "docker" "build" "--platform" platform
                                             "-t" "lambda-mvp-jnk:latest" ".")]
                 (System/exit exit))}

  deploy {:doc "idempotent: ECR repo + IAM role + Lambda function, create or update"
          :task (p/shell "bb" "script/aws_lifecycle.clj" "deploy")}

  invoke {:doc "single ad-hoc invoke, prints response + REPORT line"
          :task (p/shell "bb" "script/aws_lifecycle.clj" "invoke")}

  teardown {:doc "delete the function + role + ECR repo"
            :task (p/shell "bb" "script/aws_lifecycle.clj" "teardown")}

  bench {:doc "cold/warm boot-time comparison across memory tiers"
         :task (p/shell "bb" "script/bench_run.clj")}

  demo {:doc "image + deploy + invoke in one go, checking every prerequisite before starting"
        :task (p/shell "bb" "script/demo.clj")}

  clean {:doc "remove build artifacts"
         :task (p/shell "rm" "-rf" "target")}}}
